// Esquema derivado de DATABASE.md (fuente de verdad).
//
// Lo que Prisma NO puede expresar vive en prisma/sql/0001_constraints.sql:
// CHECK, índices únicos parciales/por expresión y triggers de inmutabilidad.
//
// Convenciones: dinero en centavos (BigInt), fechas de negocio como DATE,
// nombres de tablas/columnas en snake_case, FKs con ON DELETE RESTRICT.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

/// Rol de un usuario en un restaurante (ARCHITECTURE.md §9). OWNER: dueño (uno por restaurante).
/// MANAGER: encargado. EDITOR: carga la semana. VIEWER: solo lectura. SELF: solo lo de su
/// empleado vinculado (memberships.employee_id).
enum MembershipRole {
  OWNER
  MANAGER
  EDITOR
  VIEWER
  SELF

  @@map("membership_role")
}

enum Currency {
  ARS
  USD

  @@map("currency")
}

enum RateSource {
  MANUAL
  API

  @@map("rate_source")
}

// ─────────── Política de distribución (CONFIG-MODEL.md) ───────────
// Cada enum tiene SOLO los valores que GUTIP implementa hoy. Una modalidad nueva agrega su
// valor cuando exista su cálculo (no se anticipan valores).

/// Período de liquidación.
enum PeriodKind {
  WEEKLY

  @@map("period_kind")
}

/// Cuándo se reparte: una vez por período con el pozo acumulado.
enum SplitTiming {
  PER_PERIOD

  @@map("split_timing")
}

/// Qué horas se usan: el total del período.
enum HoursBasis {
  PERIOD_TOTAL

  @@map("hours_basis")
}

/// Cómo se cargan las horas: el total de cada persona al cerrar.
enum HoursEntry {
  PERIOD_TOTAL_AT_CLOSE

  @@map("hours_entry")
}

/// Fuentes del pozo: un monto por día.
enum PotSources {
  SINGLE_DAILY_AMOUNT

  @@map("pot_sources")
}

/// Estructura del pozo: pozo único (reemplaza a restaurants.pool_mode).
enum PoolStructure {
  SINGLE_POOL
  /// Por sectores, en etapas: cada puesto es un sector con etapa y %; la etapa 1 sobre el total,
  /// las siguientes sobre el saldo (policy_version_positions.stage / stage_percent).
  STAGED_SECTORS

  @@map("pool_structure")
}

/// Método de participación (cómo se calcula el ponderado de cada persona):
/// BY_POSITION = horas × porción del puesto · BY_POINTS = horas × puntos individuales ·
/// BY_POSITION_TIMES_POINTS = horas × porción × puntos individuales.
enum PortionMode {
  BY_POSITION
  BY_POINTS
  BY_POSITION_TIMES_POINTS

  @@map("portion_mode")
}

/// Cómo se MUESTRA la porción de los puestos (0,022 o 2,2 %). Solo presentación: la porción se
/// guarda siempre como fracción decimal y cambiar esto no crea una versión de la política.
enum PortionDisplay {
  DECIMAL
  PERCENT

  @@map("portion_display")
}

/// Unidad del reparto (mayor resto en esa unidad).
enum RoundingUnit {
  CENT
  PESO

  @@map("rounding_unit")
}

/// De qué propina se descuentan los adelantos: de todo el período.
enum AdvanceDeduction {
  WHOLE_PERIOD

  @@map("advance_deduction")
}

/// Quién prepara y entrega sobres (revertir una entrega es siempre del Encargado/Dueño).
enum EnvelopeHandlers {
  MANAGER_ONLY
  MANAGER_AND_EDITOR

  @@map("envelope_handlers")
}

/// Cómo nació una versión de la política.
enum PolicyOrigin {
  STANDARD
  COPY
  CHANGE

  @@map("policy_origin")
}

/// Alcance de un reparto: un día o el período completo.
enum DistributionScope {
  DAY
  PERIOD

  @@map("distribution_scope")
}

enum DailyDistributionStatus {
  DRAFT
  CLOSED
  VOIDED

  @@map("daily_distribution_status")
}

enum SettlementStatus {
  OPEN
  CLOSED
  VOIDED

  @@map("settlement_status")
}

enum PaymentStatus {
  PENDING
  PREPARED
  DELIVERED
  VOIDED

  @@map("payment_status")
}

enum PaymentEventType {
  CREATED
  PREPARED
  PREPARATION_UNDONE
  DELIVERED
  DELIVERY_REVERTED
  VOIDED

  @@map("payment_event_type")
}

enum AdvanceStatus {
  PENDING
  APPLIED
  VOIDED

  @@map("advance_status")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("auth_token_type")
}

// ─────────────────────── Identidad y acceso ───────────────────────

/// Usuario. Better Auth lo usa como su modelo `user` (campos name, email, emailVerified, image,
/// createdAt, updatedAt); la contraseña vive en `accounts` (proveedor "credential").
/// password_hash, email_verified_at y password_changed_at son del diseño anterior a Better Auth:
/// no se usan y quedan hasta decidir su limpieza (sin datos en ninguna base).
model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique
  name              String
  emailVerified     Boolean   @default(false) @map("email_verified")
  image             String?
  passwordHash      String?   @map("password_hash")
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(6)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions                  Session[]
  accounts                  Account[]
  memberships               Membership[]
  authTokens                AuthToken[]
  exchangeRatesCreated      ExchangeRate[]              @relation("ExchangeRateCreatedBy")
  dailyDistributionsCreated DailyDistribution[]         @relation("DailyDistributionCreatedBy")
  dailyDistributionsClosed  DailyDistribution[]         @relation("DailyDistributionClosedBy")
  dailyDistributionsVoided  DailyDistribution[]         @relation("DailyDistributionVoidedBy")
  advancesCreated           Advance[]                   @relation("AdvanceCreatedBy")
  advancesVoided            Advance[]                   @relation("AdvanceVoidedBy")
  policyVersionsCreated     DistributionPolicyVersion[] @relation("PolicyVersionCreatedBy")
  periodPolicyChanges       PeriodPolicyChange[]        @relation("PeriodPolicyChangePerformedBy")
  periodHoursUpdated        PeriodHours[]               @relation("PeriodHoursUpdatedBy")
  settlementsCreated        WeeklySettlement[]          @relation("SettlementCreatedBy")
  settlementsClosed         WeeklySettlement[]          @relation("SettlementClosedBy")
  settlementsVoided         WeeklySettlement[]          @relation("SettlementVoidedBy")
  paymentsPrepared          WeeklyPayment[]             @relation("PaymentPreparedBy")
  paymentsDelivered         WeeklyPayment[]             @relation("PaymentDeliveredBy")
  paymentEventsPerformed    WeeklyPaymentEvent[]        @relation("PaymentEventPerformedBy")
  paymentEventsAuthorized   WeeklyPaymentEvent[]        @relation("PaymentEventAuthorizedBy")
  auditLogs                 AuditLog[]
  feedbackSent              Feedback[]                  @relation("FeedbackSentBy")
  feedbackStatusChanged     Feedback[]                  @relation("FeedbackStatusChangedBy")

  @@map("users")
}

/// Verificación de email y recuperación de contraseña. Solo se guarda el hash SHA-256 del token.
model AuthToken {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, type])
  @@map("auth_tokens")
}

/// Sesión de Better Auth (modelo `session`). La cookie guarda el token firmado; se revoca borrando la fila.
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Cuenta de Better Auth (modelo `account`): con email y contraseña, providerId = "credential",
/// accountId = id del usuario y `password` = hash (scrypt de Better Auth).
model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Tokens de Better Auth (modelo `verification`: verificación de email, reset de contraseña).
model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

/// Límite de intentos de Better Auth (login, etc.) en Postgres: en serverless la memoria no se
/// comparte. `last_request` en milisegundos desde 1970 (así lo guarda Better Auth).
model AuthRateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("auth_rate_limits")
}

/// Límite de intentos (login, registro, reenvíos, reset) en Postgres: en serverless la memoria no se comparte.
/// Diseño anterior a Better Auth (que usa auth_rate_limits): no se usa; sin datos.
model RateLimit {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@map("rate_limits")
}

/// El día de inicio del período y la estructura del pozo viven en la política de distribución.
model Restaurant {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  timezone               String         @default("America/Argentina/Buenos_Aires")
  /// Versión vigente de la política (la que toman los períodos nuevos). Null solo mientras se crea el restaurante.
  currentPolicyVersionId String?        @map("current_policy_version_id") @db.Uuid
  /// Preferencia de presentación de las porciones (no es parte de la política: no se versiona).
  portionDisplay         PortionDisplay @default(DECIMAL) @map("portion_display")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt             DateTime?      @map("archived_at") @db.Timestamptz(6)

  currentPolicyVersion DistributionPolicyVersion?  @relation("RestaurantCurrentPolicyVersion", fields: [currentPolicyVersionId], references: [id], onDelete: Restrict)
  policyVersions       DistributionPolicyVersion[] @relation("RestaurantPolicyVersions")
  periodPolicyChanges  PeriodPolicyChange[]
  periodHours          PeriodHours[]

  memberships         Membership[]
  teams               Team[]
  positions           Position[]
  employees           Employee[]
  exchangeRates       ExchangeRate[]
  dailyDistributions  DailyDistribution[]
  advances            Advance[]
  weeklySettlements   WeeklySettlement[]
  weeklyPayments      WeeklyPayment[]
  weeklyPaymentEvents WeeklyPaymentEvent[]
  auditLogs           AuditLog[]

  @@map("restaurants")
}

/// Autorización: qué puede hacer un usuario en un restaurante. Un OWNER por restaurante y SELF
/// siempre vinculado a un empleado del mismo restaurante (índices, CHECK y trigger en
/// sql/constraints.sql).
model Membership {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  restaurantId String         @map("restaurant_id") @db.Uuid
  role         MembershipRole
  /// Empleado vinculado (opcional; obligatorio para SELF). Del mismo restaurante.
  employeeId   String?        @map("employee_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  employee   Employee?  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([userId, restaurantId])
  @@map("memberships")
}

// ───────────────────────────── Catálogos ─────────────────────────────

model Team {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  name         String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  positions  Position[]

  @@unique([restaurantId, name])
  @@map("teams")
}

/// Identidad estable del puesto. Su porción (valor de cálculo por hora) vive en cada versión de la
/// política (policy_version_positions). Renombrar un puesto no crea una versión.
/// Nombre único por restaurante (sin distinguir mayúsculas): índice en sql/constraints.sql.
model Position {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  /// Opcional mientras los equipos no sean una funcionalidad activa.
  teamId       String?   @map("team_id") @db.Uuid
  name         String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)

  restaurant        Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  team              Team?                   @relation(fields: [teamId], references: [id], onDelete: Restrict)
  defaultForStaff   Employee[]              @relation("EmployeeDefaultPosition")
  distributionItems DailyDistributionItem[]
  versionPortions   PolicyVersionPosition[]

  @@index([restaurantId])
  @@map("positions")
}

model Employee {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId      String    @map("restaurant_id") @db.Uuid
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  documentId        String?   @map("document_id")
  defaultPositionId String?   @map("default_position_id") @db.Uuid
  /// Puntos individuales (> 0, CHECK en sql). Dato del empleado, no de la política: no se versiona;
  /// el valor usado se congela en cada ítem al cerrar (individual_points_snapshot).
  individualPoints  Decimal   @default(1) @map("individual_points") @db.Decimal(6, 2)
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)

  restaurant        Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  defaultPosition   Position?               @relation("EmployeeDefaultPosition", fields: [defaultPositionId], references: [id], onDelete: Restrict)
  memberships       Membership[]
  distributionItems DailyDistributionItem[]
  advances          Advance[]
  weeklyPayments    WeeklyPayment[]
  periodHours       PeriodHours[]

  @@index([restaurantId, active])
  @@map("employees")
}

/// Cotización oficial venta por fecha.
model ExchangeRate {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  date         DateTime   @db.Date
  currencyPair String     @default("USD_ARS") @map("currency_pair")
  rate         Decimal    @db.Decimal(18, 6)
  source       RateSource @default(MANUAL)
  note         String?
  createdById  String     @map("created_by") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  createdBy  User       @relation("ExchangeRateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  tipEntries TipEntry[]

  @@unique([restaurantId, date, currencyPair])
  @@map("exchange_rates")
}

// ─────────────── DAILY DISTRIBUTION (unidad de cálculo) ───────────────

/// Un reparto de propinas. `DAY`: un día (date_from = date_to). `PERIOD`: el período completo
/// (la política reparte una vez por período con el pozo acumulado; cada propina lleva su día).
/// Una vez CLOSED es inmutable (triggers). Pertenece a la liquidación del período que la contiene.
model DailyDistribution {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId       String                  @map("restaurant_id") @db.Uuid
  scope              DistributionScope
  dateFrom           DateTime                @map("date_from") @db.Date
  dateTo             DateTime                @map("date_to") @db.Date
  status             DailyDistributionStatus @default(DRAFT)
  tipsArsCents       BigInt                  @default(0) @map("tips_ars_cents")
  tipsUsdCents       BigInt                  @default(0) @map("tips_usd_cents")
  totalCents         BigInt                  @default(0) @map("total_cents")
  totalPoints        Decimal                 @default(0) @map("total_points") @db.Decimal(30, 12)
  totalAdvancesCents BigInt                  @default(0) @map("total_advances_cents")
  totalFinalCents    BigInt                  @default(0) @map("total_final_cents")
  /// Se asigna al cerrar la liquidación semanal; con valor ≠ null la distribución no puede anularse.
  settlementId       String?                 @map("settlement_id") @db.Uuid
  notes              String?
  createdById        String                  @map("created_by") @db.Uuid
  closedAt           DateTime?               @map("closed_at") @db.Timestamptz(6)
  closedById         String?                 @map("closed_by") @db.Uuid
  voidedAt           DateTime?               @map("voided_at") @db.Timestamptz(6)
  voidedById         String?                 @map("voided_by") @db.Uuid
  voidReason         String?                 @map("void_reason")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  settlement WeeklySettlement?       @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  createdBy  User                    @relation("DailyDistributionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  closedBy   User?                   @relation("DailyDistributionClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  voidedBy   User?                   @relation("DailyDistributionVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  tipEntries TipEntry[]
  items      DailyDistributionItem[]

  @@index([restaurantId, dateFrom])
  @@index([settlementId])
  @@map("daily_distributions")
}

/// Propinas recibidas ese día, en su moneda original, con la cotización usada (copia).
model TipEntry {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dailyDistributionId String    @map("daily_distribution_id") @db.Uuid
  /// Día en que se recibió (dentro del rango del reparto).
  entryDate           DateTime  @map("entry_date") @db.Date
  currency            Currency
  /// Monto en la moneda original, en centavos.
  amountCents         BigInt    @map("amount_cents")
  /// Cotización usada (obligatoria si USD). Es una copia: editar exchange_rates no la cambia.
  exchangeRate        Decimal?  @map("exchange_rate") @db.Decimal(18, 6)
  exchangeRateDate    DateTime? @map("exchange_rate_date") @db.Date
  exchangeRateId      String?   @map("exchange_rate_id") @db.Uuid
  /// Equivalente en ARS ya convertido.
  amountArsCents      BigInt    @map("amount_ars_cents")
  note                String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  dailyDistribution DailyDistribution @relation(fields: [dailyDistributionId], references: [id], onDelete: Restrict)
  exchangeRateRef   ExchangeRate?     @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict)

  @@index([dailyDistributionId])
  @@map("tip_entries")
}

/// Una fila por empleado que trabajó ese día. Todo es snapshot al cerrar.
model DailyDistributionItem {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dailyDistributionId      String   @map("daily_distribution_id") @db.Uuid
  employeeId               String   @map("employee_id") @db.Uuid
  positionId               String   @map("position_id") @db.Uuid
  employeeNameSnapshot     String   @map("employee_name_snapshot")
  positionNameSnapshot     String   @map("position_name_snapshot")
  teamNameSnapshot         String?  @map("team_name_snapshot")
  /// Porción por hora del puesto en la versión de la política usada (p. ej. 0,65 ÷ 45).
  /// Null si el método de participación no la usa (BY_POINTS).
  portionSnapshot          Decimal? @map("portion_snapshot") @db.Decimal(20, 10)
  /// Puntos individuales usados. Null si el método no los usa (BY_POSITION).
  individualPointsSnapshot Decimal? @map("individual_points_snapshot") @db.Decimal(6, 2)
  /// Horas del alcance del reparto (del día o del período).
  hours                    Decimal  @db.Decimal(6, 2)
  /// Ponderado = horas × porción y/o puntos según el método (exacto).
  points                   Decimal  @db.Decimal(30, 12)
  /// points / total_points (informativo; el monto no se deriva de este valor redondeado)
  percentage               Decimal  @db.Decimal(9, 6)
  /// Importe bruto del día (método del mayor resto).
  amountCents              BigInt   @map("amount_cents")
  advancesCents            BigInt   @default(0) @map("advances_cents")
  /// Importe final del día = amount_cents − advances_cents.
  finalCents               BigInt   @map("final_cents")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  dailyDistribution   DailyDistribution    @relation(fields: [dailyDistributionId], references: [id], onDelete: Restrict)
  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  position            Position             @relation(fields: [positionId], references: [id], onDelete: Restrict)
  advanceApplications AdvanceApplication[]

  @@unique([dailyDistributionId, employeeId])
  @@index([employeeId])
  @@map("daily_distribution_items")
}

// ───────────────────── Adelantos y saldo pendiente ─────────────────────

/// Saldo pendiente = amount_cents − applied_cents. Un adelanto que supera el importe
/// de un día se aplica hasta donde alcanza y queda PENDING para los próximos cierres.
model Advance {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String        @map("restaurant_id") @db.Uuid
  employeeId   String        @map("employee_id") @db.Uuid
  date         DateTime      @db.Date
  amountCents  BigInt        @map("amount_cents")
  appliedCents BigInt        @default(0) @map("applied_cents")
  status       AdvanceStatus @default(PENDING)
  note         String?
  createdById  String        @map("created_by") @db.Uuid
  /// Anulación (VOIDED): quién, cuándo y por qué (motivo obligatorio).
  voidedAt     DateTime?     @map("voided_at") @db.Timestamptz(6)
  voidedById   String?       @map("voided_by") @db.Uuid
  voidReason   String?       @map("void_reason")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy    User                 @relation("AdvanceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy     User?                @relation("AdvanceVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  applications AdvanceApplication[]

  @@index([restaurantId, employeeId, status])
  @@map("advances")
}

/// Cómo se consumió cada adelanto. `reverted_at` se completa si se anula la distribución diaria.
model AdvanceApplication {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  advanceId               String    @map("advance_id") @db.Uuid
  dailyDistributionItemId String    @map("daily_distribution_item_id") @db.Uuid
  amountCents             BigInt    @map("amount_cents")
  revertedAt              DateTime? @map("reverted_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  advance Advance               @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  item    DailyDistributionItem @relation(fields: [dailyDistributionItemId], references: [id], onDelete: Restrict)

  @@unique([advanceId, dailyDistributionItemId])
  @@map("advance_applications")
}

// ───────────────── WEEKLY SETTLEMENT (acumulación) ─────────────────

/// El PERÍODO: se abre (OPEN) fijado a una versión de la política y, al cerrar, acumula los
/// repartos CLOSED del período (no recalcula: suma) y guarda el snapshot de la configuración usada.
model WeeklySettlement {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId           String           @map("restaurant_id") @db.Uuid
  weekStart              DateTime         @map("week_start") @db.Date
  weekEnd                DateTime         @map("week_end") @db.Date
  /// 1 la primera vez; 2, 3… cuando se re-liquida la misma semana tras una anulación.
  revision               Int              @default(1)
  supersedesSettlementId String?          @unique @map("supersedes_settlement_id") @db.Uuid
  status                 SettlementStatus @default(OPEN)
  /// Versión de la política fijada al abrir el período (congelada al cerrar).
  policyVersionId        String           @map("policy_version_id") @db.Uuid
  /// Copia de los valores de la política usados al cerrar (auditoría; el modelo tipado es la versión).
  policySnapshot         Json?            @map("policy_snapshot")
  /// Versión del cálculo que produjo el cierre.
  calcVersion            String?          @map("calc_version")
  totalCents             BigInt?          @map("total_cents")
  totalAdvancesCents     BigInt?          @map("total_advances_cents")
  totalFinalCents        BigInt?          @map("total_final_cents")
  notes                  String?
  createdById            String           @map("created_by") @db.Uuid
  closedAt               DateTime?        @map("closed_at") @db.Timestamptz(6)
  closedById             String?          @map("closed_by") @db.Uuid
  voidedAt               DateTime?        @map("voided_at") @db.Timestamptz(6)
  voidedById             String?          @map("voided_by") @db.Uuid
  voidReason             String?          @map("void_reason")
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant         Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  supersedes         WeeklySettlement?         @relation("SettlementSupersedes", fields: [supersedesSettlementId], references: [id], onDelete: Restrict)
  supersededBy       WeeklySettlement?         @relation("SettlementSupersedes")
  createdBy          User                      @relation("SettlementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  closedBy           User?                     @relation("SettlementClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  voidedBy           User?                     @relation("SettlementVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  policyVersion      DistributionPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  dailyDistributions DailyDistribution[]
  payments           WeeklyPayment[]
  policyChanges      PeriodPolicyChange[]
  hours              PeriodHours[]

  @@unique([restaurantId, weekStart, revision])
  @@index([restaurantId, status])
  @@map("weekly_settlements")
}

// ───────────── WEEKLY ENVELOPE / PAYMENT (unidad de pago) ─────────────

/// El sobre de cada empleado. Los campos monetarios son inmutables; solo cambian
/// estado/preparación/entrega. La historia completa está en weekly_payment_events.
model WeeklyPayment {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId             String        @map("restaurant_id") @db.Uuid
  settlementId             String        @map("settlement_id") @db.Uuid
  employeeId               String        @map("employee_id") @db.Uuid
  employeeNameSnapshot     String        @map("employee_name_snapshot")
  periodStart              DateTime      @map("period_start") @db.Date
  periodEnd                DateTime      @map("period_end") @db.Date
  /// Total semanal = Σ amount_cents de sus ítems diarios.
  grossCents               BigInt        @map("gross_cents")
  advancesCents            BigInt        @default(0) @map("advances_cents")
  /// Importe a entregar = Σ final_cents.
  netCents                 BigInt        @map("net_cents")
  status                   PaymentStatus @default(PENDING)
  preparedAt               DateTime?     @map("prepared_at") @db.Timestamptz(6)
  preparedById             String?       @map("prepared_by") @db.Uuid
  /// Fecha y hora de entrega (la fija el servidor).
  deliveredAt              DateTime?     @map("delivered_at") @db.Timestamptz(6)
  /// Usuario que entregó el sobre.
  deliveredById            String?       @map("delivered_by") @db.Uuid
  deliveryNote             String?       @map("delivery_note")
  supersedesPaymentId      String?       @unique @map("supersedes_payment_id") @db.Uuid
  /// Importe entregado en sobres anteriores revertidos (informativo).
  previouslyDeliveredCents BigInt        @default(0) @map("previously_delivered_cents")
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  settlement   WeeklySettlement     @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  preparedBy   User?                @relation("PaymentPreparedBy", fields: [preparedById], references: [id], onDelete: Restrict)
  deliveredBy  User?                @relation("PaymentDeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict)
  supersedes   WeeklyPayment?       @relation("PaymentSupersedes", fields: [supersedesPaymentId], references: [id], onDelete: Restrict)
  supersededBy WeeklyPayment?       @relation("PaymentSupersedes")
  events       WeeklyPaymentEvent[]

  @@unique([settlementId, employeeId])
  @@index([restaurantId, status])
  @@index([employeeId, periodStart])
  @@map("weekly_payments")
}

/// Bitácora inmutable (solo INSERT) de cada cambio de estado de un sobre.
model WeeklyPaymentEvent {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId   String           @map("restaurant_id") @db.Uuid
  paymentId      String           @map("payment_id") @db.Uuid
  eventType      PaymentEventType @map("event_type")
  fromStatus     PaymentStatus?   @map("from_status")
  toStatus       PaymentStatus    @map("to_status")
  /// Importe del sobre en ese momento.
  amountCents    BigInt           @map("amount_cents")
  performedById  String           @map("performed_by") @db.Uuid
  /// Obligatorio en DELIVERY_REVERTED.
  authorizedById String?          @map("authorized_by") @db.Uuid
  /// Obligatorio (mín. 10 caracteres) en DELIVERY_REVERTED, VOIDED y PREPARATION_UNDONE.
  reason         String?
  occurredAt     DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(6)

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  payment      WeeklyPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  performedBy  User          @relation("PaymentEventPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)
  authorizedBy User?         @relation("PaymentEventAuthorizedBy", fields: [authorizedById], references: [id], onDelete: Restrict)

  @@index([paymentId, occurredAt])
  @@map("weekly_payment_events")
}

// ─────────── POLÍTICA DE DISTRIBUCIÓN versionada (CONFIG-MODEL.md) ───────────

/// Una versión de la política de un restaurante. Nunca se edita ni se borra (trigger): cambiar la
/// política crea una versión nueva. La configuración estándar vive en el código y queda registrada
/// con template_code / template_version.
model DistributionPolicyVersion {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId        String           @map("restaurant_id") @db.Uuid
  /// 1, 2, 3… por restaurante.
  number              Int
  origin              PolicyOrigin
  templateCode        String?          @map("template_code")
  templateVersion     Int?             @map("template_version")
  /// Versión anterior del mismo restaurante (cambios).
  previousVersionId   String?          @map("previous_version_id") @db.Uuid
  /// Versión de origen cuando es copia (puede ser de otro restaurante).
  copiedFromVersionId String?          @map("copied_from_version_id") @db.Uuid
  /// Qué cambió, generado por el servicio (p. ej. "Redondeo: Centavos → Pesos enteros").
  summary             String
  periodKind          PeriodKind       @map("period_kind")
  /// 1 = lunes … 7 = domingo (ISO). El estándar es lunes; cada restaurante puede tener otro.
  periodStartWeekday  Int              @map("period_start_weekday") @db.SmallInt
  splitTiming         SplitTiming      @map("split_timing")
  hoursBasis          HoursBasis       @map("hours_basis")
  hoursEntry          HoursEntry       @map("hours_entry")
  potSources          PotSources       @map("pot_sources")
  poolStructure       PoolStructure    @map("pool_structure")
  portionMode         PortionMode      @map("portion_mode")
  roundingUnit        RoundingUnit     @map("rounding_unit")
  advanceDeduction    AdvanceDeduction @map("advance_deduction")
  envelopeHandlers    EnvelopeHandlers @map("envelope_handlers")
  createdById         String           @map("created_by") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant      Restaurant                  @relation("RestaurantPolicyVersions", fields: [restaurantId], references: [id], onDelete: Restrict)
  currentFor      Restaurant[]                @relation("RestaurantCurrentPolicyVersion")
  previousVersion DistributionPolicyVersion?  @relation("PolicyVersionPrevious", fields: [previousVersionId], references: [id], onDelete: Restrict)
  nextVersions    DistributionPolicyVersion[] @relation("PolicyVersionPrevious")
  copiedFrom      DistributionPolicyVersion?  @relation("PolicyVersionCopiedFrom", fields: [copiedFromVersionId], references: [id], onDelete: Restrict)
  copies          DistributionPolicyVersion[] @relation("PolicyVersionCopiedFrom")
  createdBy       User                        @relation("PolicyVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  positions       PolicyVersionPosition[]
  settlements     WeeklySettlement[]
  changesFrom     PeriodPolicyChange[]        @relation("PolicyChangeFrom")
  changesTo       PeriodPolicyChange[]        @relation("PolicyChangeTo")

  @@unique([restaurantId, number])
  @@map("distribution_policy_versions")
}

/// Los puestos de una versión con su porción por hora. Solo se insertan junto con su versión.
model PolicyVersionPosition {
  versionId    String   @map("version_id") @db.Uuid
  positionId   String   @map("position_id") @db.Uuid
  /// Porción por hora (> 0). 10 decimales: representa 0,65 ÷ 45 y preserva los resultados de Library.
  portion      Decimal  @db.Decimal(20, 10)
  sortOrder    Int      @default(0) @map("sort_order")
  /// Reparto por sectores: etapa del puesto (1 = sobre el total; 2… = sobre el saldo). NULL sin asignar.
  stage        Int?     @db.SmallInt
  /// Reparto por sectores: % de la base de su etapa (0 < % ≤ 100). NULL sin asignar.
  stagePercent Decimal? @map("stage_percent") @db.Decimal(5, 2)

  version  DistributionPolicyVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  position Position                  @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@id([versionId, positionId])
  @@index([positionId])
  @@map("policy_version_positions")
}

/// Bitácora (solo INSERT) de cambios de versión de un período abierto: automáticos (al cambiar la
/// política) o elegidos a mano (motivo obligatorio).
model PeriodPolicyChange {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId  String   @map("restaurant_id") @db.Uuid
  settlementId  String   @map("settlement_id") @db.Uuid
  fromVersionId String   @map("from_version_id") @db.Uuid
  toVersionId   String   @map("to_version_id") @db.Uuid
  automatic     Boolean
  reason        String?
  performedById String   @map("performed_by") @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  restaurant  Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  settlement  WeeklySettlement          @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  fromVersion DistributionPolicyVersion @relation("PolicyChangeFrom", fields: [fromVersionId], references: [id], onDelete: Restrict)
  toVersion   DistributionPolicyVersion @relation("PolicyChangeTo", fields: [toVersionId], references: [id], onDelete: Restrict)
  performedBy User                      @relation("PeriodPolicyChangePerformedBy", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([settlementId, occurredAt])
  @@map("period_policy_changes")
}

/// Horas de cada persona en el período (dato de entrada; editable solo con el período OPEN).
model PeriodHours {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  settlementId String   @map("settlement_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  /// Tope: 24 × días del período (trigger), no un límite de negocio.
  hours        Decimal  @db.Decimal(6, 2)
  updatedById  String   @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  settlement WeeklySettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  updatedBy  User             @relation("PeriodHoursUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([settlementId, employeeId])
  @@map("period_hours")
}

// ───────────────────────────── Auditoría ─────────────────────────────

/// Bitácora de solo inserción: cierres, anulaciones, cambios de estado de sobres, cotizaciones.
model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String?  @map("restaurant_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String
  entity       String
  entityId     String?  @map("entity_id") @db.Uuid
  payload      Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  user       User?       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([restaurantId, createdAt])
  @@index([entity, entityId])
  @@map("audit_log")
}

// ─────────────────────── Comentarios de testers ───────────────────────

/// Tipo de comentario que deja quien prueba GUTIP.
enum FeedbackCategory {
  BUG
  SUGGESTION
  COMMENT

  @@map("feedback_category")
}

/// Estado de un comentario en la revisión del equipo de GUTIP.
enum FeedbackStatus {
  NEW
  IN_REVIEW
  RESOLVED

  @@map("feedback_status")
}

/// Comentarios y sugerencias de quienes prueban GUTIP. No es de un restaurante: es sobre la app.
/// Se puede enviar sin cuenta (user_id NULL); con sesión se asocia al usuario. No guarda IP ni
/// navegador. Lo revisan los emails de GUTIP_FEEDBACK_REVIEWERS, que pueden borrarlo.
model Feedback {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category          FeedbackCategory
  /// Título opcional (1–120 caracteres).
  title             String?
  /// Descripción (10–4000 caracteres).
  description       String
  /// Pantalla desde la que se envió ("/reparto"), opcional.
  page              String?
  status            FeedbackStatus   @default(NEW)
  userId            String?          @map("user_id") @db.Uuid
  statusChangedAt   DateTime?        @map("status_changed_at") @db.Timestamptz(6)
  statusChangedById String?          @map("status_changed_by") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User? @relation("FeedbackSentBy", fields: [userId], references: [id], onDelete: Restrict)
  statusChangedBy User? @relation("FeedbackStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@map("feedback")
}
