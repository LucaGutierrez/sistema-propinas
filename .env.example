# Copiar a apps/web/.env (ese archivo NO se versiona) y completar.
# Nunca poner valores reales en este archivo.

# PostgreSQL (Neon, Supabase o local). Ejemplo de formato:
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:5432/propinas?schema=public"

# --- Fase 1: datos reales en "Configuración de distribución" (solo desarrollo) ---
# Sin GUTIP_DATA_SOURCE=database la app usa la demo del navegador y no toca la base.
# Mientras no haya login, el restaurante y el operador se eligen acá (el acceso se verifica
# igual contra la base: el operador tiene que ser miembro del restaurante).
# GUTIP_DATA_SOURCE=database
# GUTIP_RESTAURANT_ID=00000000-0000-0000-0000-000000000000   # uuid propio
# GUTIP_OPERATOR_EMAIL=operador@example.com
# Solo para `pnpm --filter @propinas/web db:bootstrap --confirm` (inicializa ese restaurante):
# GUTIP_RESTAURANT_NAME=Mi restaurante
# GUTIP_OPERATOR_NAME=Operador

# --- Fase 1 (autenticación y email); todavía no se usan ---
# AUTH_SECRET=            # generar con: openssl rand -base64 32
# APP_URL=http://localhost:3000
# MAIL_PROVIDER=console   # console | resend
# RESEND_API_KEY=
# MAIL_FROM=
