# Copiar a apps/web/.env (ese archivo NO se versiona) y completar.
# Nunca poner valores reales en este archivo.

# PostgreSQL (Neon, Supabase o local). Ejemplo de formato:
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:5432/propinas?schema=public"

# --- Pantallas con datos reales ("Configuración de distribución") ---
# Sin GUTIP_DATA_SOURCE=database la app usa la demo del navegador y no toca la base.
# Con la base activa se exige iniciar sesión (Better Auth) y el acceso sale de las membresías.
# GUTIP_DATA_SOURCE=database

# --- Autenticación (Better Auth) ---
# Secreto para firmar la sesión: 32+ caracteres aleatorios (p. ej. `openssl rand -base64 32`).
# Uno distinto por entorno; nunca versionarlo.
# BETTER_AUTH_SECRET=
# Origen público de la app (en producción, con https://).
# BETTER_AUTH_URL=http://localhost:3000

# --- Solo para scripts manuales (no intervienen en la autorización de la app) ---
# `db:bootstrap --confirm` inicializa este restaurante y su dueño;
# `db:operator-password --confirm` le define la contraseña al dueño (la pide por teclado).
# GUTIP_RESTAURANT_ID=00000000-0000-0000-0000-000000000000   # uuid propio
# GUTIP_RESTAURANT_NAME=Mi restaurante
# GUTIP_OPERATOR_EMAIL=operador@example.com
# GUTIP_OPERATOR_NAME=Operador

# --- Email (verificación y recuperación de contraseña); todavía no se usan ---
# MAIL_PROVIDER=console   # console | resend
# RESEND_API_KEY=
# MAIL_FROM=
